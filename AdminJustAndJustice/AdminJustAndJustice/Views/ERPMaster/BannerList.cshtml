@model AdminJustAndJustice.Models.ERPBannerModel
@{
    ViewData["Title"] = "BannerList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-8">
                            <h4 class="card-title">Banner List</h4>

                        </div>
                        <div class="col-lg-4" style="text-align: right;">
                            <a href="/BannerMaster" class="btn btn-primary btn-sm">Add Banner</a>
                                                         
                        </div>
                    </div>
                    @*                     <p class="card-description">
                        Add class <code>.table-bordered</code>
                    </p> *@
                    <div class="table-responsive pt-3">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                 
                                    <th>#</th>
                                    <th>Banner</th>
                                    <th>Title</th>
                                    <th>Video Url</th>
                                    <th>Details</th>
                                    @*           <th>Action</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    @if (Model?.dtBanner != null && Model.dtBanner.Rows.Count > 0)
                                    {
                                        int j = 1;
                                        @for (var i = 0; i < @Model.dtBanner.Rows.Count; i++)
                                        {
                                            <tr>
                                                <td style="position:relative;">
                                                    <div class="dropright">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                            @j &nbsp; &nbsp;<i class="mdi mdi-cog"></i>
                                                        </button>
                                                        <div class="dropdown-menu" x-placement="right-start">
                                                            <form class="forms-sample" asp-action="BannerMaster" asp-controller="ERPMaster" enctype="multipart/form-data">
                                                                <input type="hidden" asp-for="EditBannerID" value="@Convert.ToString(@Model.dtBanner.Rows[i]["BannerID"])" />
                                                                <button type="submit" class="dropdown-item text-primary" title="Edit"><i class="mdi mdi-pencil"></i>Edit</button>
                                                            </form>
                                                            @* <a href="#" class="dropdown-item text-danger" onclick="fn_ShowDeleteModal(@Model.dtBanner.Rows[i]["BannerID"])"><i class="mdi mdi-trash-can"></i>Delete</a> *@
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <a href="@Convert.ToString(@Model.dtBanner.Rows[i]["strImageURL"])" target="_blank"><img src="@Convert.ToString(@Model.dtBanner.Rows[i]["strImageURL"])" alt=""></a>
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtBanner.Rows[i]["strBannerTitle"])
                                                </td>
                                                <td>
                                                    <a href="@Convert.ToString(@Model.dtBanner.Rows[i]["strVideoURL"])" target="_blank">@Convert.ToString(@Model.dtBanner.Rows[i]["strVideoURL"])</a>
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtBanner.Rows[i]["strDetials"])
                                                </td>
                                                
                                            </tr>
                                            j++;
                                        }
                                    }
                                    else
                                    {
                                        <tr> <td colspan="20" style="text-align:center;font-weight:bold;color:#dc3545"><i>No Record Found!</i></td></tr>
                                    }
                                }
                                else
                                {
                                    <tr> <td colspan="20" style="text-align:center;font-weight:bold;color:#dc3545"><i>No Record Found!</i></td></tr>
                                }

                            
                               
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>