@model AdminJustAndJustice.Models.ContactModel
@using Newtonsoft.Json;
@{
    ViewData["Title"] = "ContactMaster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .duplicate-error {
        background-color: #ffe6e6;
        border: 1px solid red;
    }
</style>
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Contact Master</h4>
                    @if (string.IsNullOrEmpty(Model.EditContactID))
                    {
                        <p class="card-description">
                            Add Contact
                        </p>
                    }
                    else
                    {
                        <p class="card-description">
                            Update Contact
                        </p>
                    }
                    <form class="forms-sample" asp-action="AddAndUpdateContact" autocomplete="off" asp-controller="ERPMaster" enctype="multipart/form-data">
                        <div class="form-group">
                            <label for="ContactTitle">Title <span class="text-danger"><b>*</b></span></label>
                            <input type="text" class="form-control" placeholder="Title" maxlength="250" asp-for="ContactTitle">
                            </div>
                           
                             
                      
                            <div class="form-group">
                                <label for="MobileNo">Mobile No <span class="text-danger"><b>*</b></span></label>
                                @if (string.IsNullOrEmpty(Model.EditContactID))
                                {
                                    <div id="phoneContainer">
                                        <div class="input-group mb-2">
                                            <input type="text" name="MobileNos" class="form-control phone-input" maxlength="10" oninput="return validatePriceInput(this)" onkeypress="restrictInvalidCharacters(event)" placeholder="Moblie No.">
                                            <button type="button" class="btn btn-danger removePhone">X</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    {
                                        var mobileJson = Convert.ToString(Model.MobileNo);
                                        var mobiles = string.IsNullOrEmpty(mobileJson)
                                            ? new List<MobileDto>()
                                            : JsonConvert.DeserializeObject<List<MobileDto>>(mobileJson);
                                        @if (mobiles != null && mobiles.Count > 0)
                                        {
                                            @foreach (var m in mobiles)
                                            {
                                                <div id="phoneContainer">
                                                    <div class="input-group mb-2">
                                                        <input type="text" name="MobileNos" class="form-control phone-input" maxlength="10" oninput="return validatePriceInput(this)" onkeypress="restrictInvalidCharacters(event)" placeholder="Moblie No." value="@m.mobile">
                                                        <button type="button" class="btn btn-danger removePhone">X</button>
                                                    </div>
                                                </div>
                                            
                                            }
                                        }
                                    }
                                }
                            </div>
                            <div class="form-group">
                                <button type="button" class="btn btn-success rounded-5 btn-sm" onclick="addPhone()">+ Add Phone</button>
                            </div>

                            <div class="form-group">
                                <label for="EmailId">Email Id <span class="text-danger"><b>*</b></span></label>
                                @if (string.IsNullOrEmpty(Model.EditContactID))
                                {
                                    <div id="emailContainer" class="mt-3">
                                        <div class="input-group mb-2">
                                            <input type="text" name="Emails" class="form-control email-input" placeholder="Email">
                                            <button type="button" class="btn  btn-danger removeEmail">X</button>
                                        </div>
                                    </div>
                                   
                                }
                                else
                                {
                                    {
                                        var emailJson = Convert.ToString(Model.EmailId);
                                        var emails = string.IsNullOrEmpty(emailJson)
                                            ? new List<EmailDto>()
                                            : JsonConvert.DeserializeObject<List<EmailDto>>(emailJson);
                                        @if (emails != null && emails.Count > 0)
                                        {
                                            <div id="emailContainer" class="mt-3">
                                                @foreach (var e in emails)
                                                {
                                                    <div class="input-group mb-2">
                                                        <input type="text" name="Emails" class="form-control email-input" placeholder="Email" value="@e.email">
                                                        <button type="button" class="btn  btn-danger removeEmail">X</button>
                                                    </div>
                                                }
                                            </div>
                                         
                                        }
                                    }

                                }
                                <div class="form-group">
                                    <button type="button" class="btn  rounded-5 btn-success btn-sm" onclick="addEmail()">+ Add Email</button>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="Location">Address <span class="text-danger"><b>*</b></span></label>
                                <textarea class="form-control" asp-for="Location"></textarea>
                            </div>
                            <div class="form-group">
                                <label for="SequnceNo">Sequnce No</label>
                                <input type="text" class="form-control" placeholder="Sequnce No" oninput="return validatePriceInput(this)" onkeypress="restrictInvalidCharacters(event)" maxlength="250" asp-for="SequnceNo">
                                </div>
                                @*      <div class="form-group">
                                    <label for="Location">Is Main Address </label>
                                    <textarea class="form-control" asp-for="Location"></textarea>
                                </div> *@
                                @if (string.IsNullOrEmpty(Model.EditContactID))
                                {
                                    <input type="submit" class="btn btn-primary me-2" name="btn_Add" value="Save" />
                                }
                                else
                                {
                                    <input type="hidden" asp-for="@Model.EditContactID" />
                                    <input type="submit" class="btn btn-primary me-2" name="btn_Add" value="Update" />
                                }
                                <a href="/ContactList" class="btn btn-light">Cancel</a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script>
                                            function isDuplicate(value, className) {
                                            let isExist = false;

                                            $('.' + className).each(function () {
                                                if ($(this).val().trim() === value.trim() && value !== "") {
                                                    isExist = true;
                                                }
                                            });

                                            return isExist;
                                        }

                                        function addPhone() {
                                            let lastValue = $('.phone-input').last().val();

                        
                                            if (!lastValue) {
                                                toastr.error("Phone number cannot be empty!");
                                                return;
                                            }

                
                                            let isExist = false;
                                            $('.phone-input').each(function () {
                                                if ($(this).val().trim() === lastValue) {
                                                    if ($(this).is($('.phone-input').last())) return;
                                                    isExist = true;
                                                }
                                            });

                                            if (isExist) {
                                                toastr.error("Duplicate phone number not allowed!");
                                                return;
                                            }


                                            $('#phoneContainer').append(`
                                                <div class="input-group mb-2">
                                                    <input type="text" name="MobileNos" class="form-control phone-input" maxlength="10" oninput="return validatePriceInput(this)" onkeypress="restrictInvalidCharacters(event)"  placeholder="Mobile No.">
                                                    <button type="button" class="btn btn-danger removePhone">X</button>
                                                </div>
                                            `);
                                        }

                                        function isValidEmail(email) {
                                let regex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                                return regex.test(email);
                            }

                                           $(document).on('blur', '.email-input', function () {

                                let val = $(this).val().trim().toLowerCase();

                                // Reset all पहले
                                $('.email-input').removeClass('duplicate-error');

                                if (!val) {
                                    toastr.error("Email cannot be empty!");
                                    return;
                                }

                                if (!isValidEmail(val)) {
                                    toastr.error("Invalid email!");
                                    $(this).addClass('duplicate-error');
                                    return;
                                }

          
                                let duplicates = [];

                                $('.email-input').each(function () {
                                    let currentVal = $(this).val().trim().toLowerCase();

                                    if (currentVal && currentVal === val) {
                                        duplicates.push(this);
                                    }
                                });

                                if (duplicates.length > 1) {
                                    toastr.error("Duplicate email!");

                
                                    duplicates.forEach(function (el) {
                                        $(el).addClass('duplicate-error');
                                    });
                                }
                            });

              
                                        $(document).on('click', '.removePhone', function () {
                                            $(this).closest('.input-group').remove();
                                        });
                            $(document).on('input', '.phone-input', function () {
                $(this).removeClass('duplicate-error');
            });

                            $(document).on('input', '.email-input', function () {
                $(this).removeClass('duplicate-error');
            });
                                        $(document).on('click', '.removeEmail', function () {
                                            $(this).closest('.input-group').remove();
                                        });
                                                    function validatePriceInput(element) {
                                            const input = element.value;
                                            const validInput = input.replace(/[^0-9]/g, '');
                                            const parts = validInput.split('.');
                                            if (parts.length > 2) {
                                                element.value = parts[0] + '.' + parts[1];
                                            } else {
                                                element.value = validInput;
                                            }
                                            return true;
                                        }

                                        function restrictInvalidCharacters(event) {
                                            const charCode = event.which || event.keyCode;
                                            const charStr = String.fromCharCode(charCode);
                                            if (!charStr.match(/^[0-9]$/)) {
                                                event.preventDefault();
                                                return false;
                                            }
                                            return true;
                                        }
                                        function isValidEmail(email) {
                let regex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                return regex.test(email);
            }

            function addEmail() {

                let lastValue = $('.email-input').last().val().trim();

                 
                if (!lastValue) {
                    toastr.error("Email cannot be empty!");
                    return;
                }

                    
                if (!isValidEmail(lastValue)) {
                    toastr.error("Invalid email format!");
                    return;
                }

                
                let isExist = false;
                $('.email-input').each(function () {
                    if ($(this).val().trim().toLowerCase() === lastValue.toLowerCase()) {
                        if ($(this).is($('.email-input').last())) return;
                        isExist = true;
                    }
                });

                if (isExist) {
                    toastr.error("Duplicate email not allowed!");
                    return;
                }

                $('#emailContainer').append(`
                    <div class="input-group mb-2">
                        <input type="text" name="Emails" class="form-control email-input" placeholder="Email">
                        <button type="button" class="btn btn-danger removeEmail">X</button>
                    </div>
                `);
            }
                            $(document).on('blur', '.phone-input', function () {

                let val = $(this).val().trim();

                $('.phone-input').removeClass('duplicate-error');

                if (!val) {
                    toastr.error("Mobile number cannot be empty!");
                    return;
                }

                let regex = /^[0-9]{10}$/;
                if (!regex.test(val)) {
                    toastr.error("Enter valid 10 digit mobile number!");
                    $(this).addClass('duplicate-error');
                    return;
                }

                let duplicates = [];

                $('.phone-input').each(function () {
                    let currentVal = $(this).val().trim();

                    if (currentVal && currentVal === val) {
                        duplicates.push(this);
                    }
                });

             
                if (duplicates.length > 1) {
                    toastr.error("Duplicate mobile number!");

                    duplicates.forEach(function (el) {
                        $(el).addClass('duplicate-error');
                    });
                }
            });
        </script>