
@model AdminJustAndJustice.Models.CaseTypeModel;
@using Newtonsoft.Json;
@{
    ViewData["Title"] = "CaseTypeList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-8">
                            <h4 class="card-title">Case Type</h4>

                        </div>
                        <div class="col-lg-4" style="text-align: right;">
                            <a href="/CaseTypeMaster" class="btn btn-primary btn-sm">Add Case Type</a>
                                                         
                        </div>
                    </div>
                    @*                     <p class="card-description">
                        Add class <code>.table-bordered</code>
                    </p> *@
                    <div class="table-responsive pt-3">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                 
                                    <th>#</th>
                                    <th>Image</th>
                                    <th>Case Type</th>
                                    <th>Short Case Type</th>
                                    <th>Tags</th>
                                    <th>Keywords</th>
                                    <th>Detials</th>
                                    <th>URL Text</th>
                                    <th>Seo title</th>
                                    <th>Seo Description</th>
                                    <th>Seq No</th>
                                    @*           <th>Action</th> *@
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    @if (Model?.dtCaseType != null && Model.dtCaseType.Rows.Count > 0)
                                    {
                                        int j = 1;
                                        @for (var i = 0; i < @Model.dtCaseType.Rows.Count; i++)
                                        {
                                            <tr>
                                                <td style="position:relative;">
                                                    <div class="dropright">
                                                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                            @j &nbsp; &nbsp;<i class="mdi mdi-cog"></i>
                                                        </button>
                                                        <div class="dropdown-menu" x-placement="right-start">
                                                            <form class="forms-sample" asp-action="CaseTypeMaster" asp-controller="ERPMaster" enctype="multipart/form-data">
                                                                <input type="hidden" asp-for="EditCaseTypeID" value="@Convert.ToString(@Model.dtCaseType.Rows[i]["CaseTypeID"])" />
                                                                <button type="submit" class="dropdown-item text-primary" title="Edit"><i class="mdi mdi-pencil"></i>Edit</button>
                                                            </form>
                                                            <form class="forms-sample" asp-action="DeleteCaseType" asp-controller="ERPMaster" enctype="multipart/form-data">
                                                                <input type="hidden" asp-for="EditCaseTypeID" value="@Convert.ToString(@Model.dtCaseType.Rows[i]["CaseTypeID"])" />
                                                                <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Are you sure for delete this records?')" title="Edit"><i class="mdi mdi-delete"></i>Delete</button>
                                                            </form>
                                                            @* <a href="#" class="dropdown-item text-danger" onclick="fn_ShowDeleteModal(@Model.dtBanner.Rows[i]["BannerID"])"><i class="mdi mdi-trash-can"></i>Delete</a> *@
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <a href="@Convert.ToString(@Model.dtCaseType.Rows[i]["strFirstImage"])" target="_blank"><img src="@Convert.ToString(@Model.dtCaseType.Rows[i]["strFirstImage"])" alt=""></a>
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strCaseType"])
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strShortCaseType"])
                                                </td>
                                                <td>
                                                    @{
                                                        var tagsJson = Convert.ToString(Model.dtCaseType.Rows[i]["strTags"]);
                                                        var tags = string.IsNullOrEmpty(tagsJson)
                                                            ? new List<SeoTagsDto>()
                                                            : JsonConvert.DeserializeObject<List<SeoTagsDto>>(tagsJson);
                                                    }

                                                    @if (tags != null && tags.Count > 0)
                                                    {
                                                        <ol>
                                                            @foreach (var m in tags)
                                                            {
                                                                <li>@m.seotags</li>
                                                            }
                                                        </ol>
                                                    }
                                                </td>

                                                <td>
                                                    @{
                                                        var seoKeywordJson = Convert.ToString(Model.dtCaseType.Rows[i]["strSeoKeywords"]);
                                                        var seoKeywords = string.IsNullOrEmpty(seoKeywordJson)
                                                            ? new List<SeoKeywordsDto>()
                                                            : JsonConvert.DeserializeObject<List<SeoKeywordsDto>>(seoKeywordJson);
                                                    }

                                                    @if (seoKeywords != null && seoKeywords.Count > 0)
                                                    {
                                                        <ol>
                                                            @foreach (var e in seoKeywords)
                                                            {
                                                                <li>@e.seoKeywords</li>
                                                            }
                                                        </ol>
                                                    }
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strDetials"])
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strURLText"])
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strSeoTitle"])
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["strSeoDescr"])
                                                </td>
                                                <td>
                                                    @Convert.ToString(@Model.dtCaseType.Rows[i]["intSequenceNo"])
                                                </td>
                                            </tr>
                                            j++;
                                        }
                                    }
                                    else
                                    {
                                        <tr> <td colspan="20" style="text-align:center;font-weight:bold;color:#dc3545"><i>No Record Found!</i></td></tr>
                                    }
                                }
                                else
                                {
                                    <tr> <td colspan="20" style="text-align:center;font-weight:bold;color:#dc3545"><i>No Record Found!</i></td></tr>
                                }

                            
                               
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

