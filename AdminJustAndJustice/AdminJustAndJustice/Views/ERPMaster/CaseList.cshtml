@model AdminJustAndJustice.Models.CaseModel
@{
    ViewData["Title"] = "CaseList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-wrapper">
    <div class="row">
        <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-8">
                            <h4 class="card-title">Case</h4>

                        </div>
                        <div class="col-lg-4" style="text-align: right;">
                            <a href="/CaseMaster" class="btn btn-primary btn-sm">Add Case</a>
                                                         
                        </div>
                    </div>
                    @*                     <p class="card-description">
                        Add class <code>.table-bordered</code>
                    </p> *@
                    <div class="table-responsive pt-3">
                        <table class="table table-bordered table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Case No</th>
                                    <th>Case Type</th>
                                    <th>Client Name</th>
                                    <th>Mobile No</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Judge Name</th>
                                    <th>Case Start</th>
                                    <th>Judgement Date</th>
                                    <th>Created Date</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model != null)
                                {
                                    @if (Model?.dtProductEnquiry != null && Model.dtProductEnquiry.Rows.Count > 0)
                                    {
                                        int j = 1;

                                        @for (var i = 0; i < Model.dtProductEnquiry.Rows.Count; i++)
                                        {
                                            <tr>

                                                <td style="position:relative;">
                                                    <div class="dropright">

                                                        <button type="button"
                                                                class="btn btn-outline-primary btn-sm"
                                                                data-bs-toggle="dropdown"
                                                                aria-haspopup="true"
                                                                aria-expanded="false">

                                                            @j &nbsp;&nbsp;<i class="ph ph-gear"></i>

                                                        </button>

                                                        <div class="dropdown-menu" x-placement="right-start">

                                                            <!-- Edit -->

                                                            <form asp-action="CaseMaster"
                                                                  asp-controller="ERPMaster"
                                                                  method="post">

                                                                <input type="hidden"
                                                                       asp-for="EditPkCaseID"
                                                                       value="@Convert.ToString(Model.dtProductEnquiry.Rows[i]["intCaseID"])" />

                                                                <button type="submit"
                                                                        class="dropdown-item text-primary">

                                                                    <i class="mdi mdi-pencil"></i> Edit

                                                                </button>

                                                            </form>

                                                            <!-- Delete -->

                                                            <form asp-action="DeleteCase"
                                                                  asp-controller="ERPMaster"
                                                                  method="post">

                                                                <input type="hidden"
                                                                       asp-for="EditPkCaseID"
                                                                       value="@Convert.ToString(Model.dtProductEnquiry.Rows[i]["intCaseID"])" />

                                                                <button type="submit"
                                                                        class="dropdown-item text-danger"
                                                                        onclick="return confirm('Are you sure want to delete this record?')">

                                                                    <i class="mdi mdi-delete"></i> Delete

                                                                </button>
                                                                <a href="javascript:void(0)" class="dropdown-item text-success"
                                                                       data-bs-toggle="modal" onclick="fn_OpenPopUp(@Convert.ToString(Model.dtProductEnquiry.Rows[i]["intCaseID"]))">
                                                                    <i class="mdi mdi-certificate"></i> Add Next Date

                                                                </a>
                                                            </form>

                                                        </div>
                                                    </div>
                                                </td>

                                                <!-- Case No -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strCaseNo"])
                                                </td>

                                                <!-- Case Type -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strCaseType"])
                                                </td>

                                                <!-- Client Name -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strClientName"])
                                                </td>

                                                <!-- Mobile -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strClientMobileNo"])
                                                </td>

                                                <!-- Status -->

                                                <td>

                                                    @if (Convert.ToString(Model.dtProductEnquiry.Rows[i]["strStatus"]) == "Pending")
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning border border-warning">
                                                            Pending
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success">
                                                            Decided
                                                        </span>
                                                    }

                                                </td>

                                                <!-- Priority -->

                                                <td>

                                                    @{
                                                        var priority = Convert.ToString(Model.dtProductEnquiry.Rows[i]["strPriority"]);
                                                    }

                                                    @if (priority == "High")
                                                    {
                                                        <span class="badge bg-danger text-white px-3 py-2">
                                                            High
                                                        </span>
                                                    }
                                                    else if (priority == "Medium")
                                                    {
                                                        <span class="badge bg-warning text-dark px-3 py-2">
                                                            Medium
                                                        </span>
                                                    }
                                                    else if (priority == "Low")
                                                    {
                                                        <span class="badge bg-success text-white px-3 py-2">
                                                            Low
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary text-white px-3 py-2">
                                                            @priority
                                                        </span>
                                                    }

                                                </td>

                                                <!-- Judge Name -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strJudgeName"])
                                                </td>

                                                <!-- Case Start -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["CaseStart"])
                                                </td>

                                                <!-- Judgement Date -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["JudgementDate"])
                                                </td>

                                                <!-- Created Date -->

                                                <td>
                                                    @Convert.ToString(Model.dtProductEnquiry.Rows[i]["strCreateDate"])
                                                </td>

                                            </tr>

                                            j++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="20"
                                                style="text-align:center;font-weight:bold;color:#dc3545">
                                                <i>No Record Found!</i>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="20"
                                            style="text-align:center;font-weight:bold;color:#dc3545">
                                            <i>No Record Found!</i>
                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade " id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Add Next Date</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form asp-action="AddNextCaseDate" asp-controller="ERPMaster" method="post" enctype="multipart/form-data" data-ajax="true" data-ajax-failure="OnSuccessVariant" data-ajax-success="OnSuccessVariant" data-ajax-loading=".preloader">
      
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="CourtNo">Court No<span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" autocomplete="off" maxlength="200" asp-for="CourtNo">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="JudgeName">Judge Name<span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" autocomplete="off" maxlength="200" asp-for="JudgeName">
                                    <input type="hidden" asp-for="PkCaseID">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label for="NextDate">Next Date<span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" autocomplete="off" asp-for="NextDate">
                                </div>
                            </div>
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label for="NextDate">Remark<span class="text-danger">*</span></label>
                                    <textarea class="form-control" autocomplete="off" rows="4" asp-for="Remark"></textarea>
                                </div>
                            </div>
                            <div class="col-sm-12 text-center">
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </div>
                    </form>
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive pt-3">
                                <table class="table table-bordered table-striped table-hover" id="tblCaseDetail">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Court No.</th>
                                            <th>Case Date</th>
                                            <th>Judge Name</th>
                                            <th>Case Date</th>
                                            <th>Remark</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
               
                </div>
            </div>
        </div>
    </div>
    <script>
         
            function OnSuccessVariant(result) {
                  try{
                      if (result.code == "0") {
                          toastr.success(result.msg)
                          fn_clearForm();
                          fns_BindDataList();
                      }
                      else {
                          toastr.error(result.msg)
                       }
                   $('.preloader').hide();
                       return false;
                  }
                  catch(error)
                  {
                       console.error("An error occurred:", error.message);
                  }
              };
                function fn_OpenPopUp(id) {
                    fn_clearForm();
                  $("#staticBackdrop").modal("show");
                  $("#PkCaseID").val(id);
                  fns_BindDataList()
              };
              function fn_clearForm()
              {
                  $("#CourtNo").val("");
                  $("#JudgeName").val("");
                  $("#NextDate").val("");
                  $("#Remark").val("");
              }
                        function fns_BindDataList() {

                $('.preloader').show();

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("CaseDetailsList", "ERPMaster")',
                    dataType: 'json',
                    data: {},

                    success: function (result) {

                        var hTable = "";

                        if (result.cnt != "0") {

                            var data = result.record;
                                $("#tblCaseDetail tbody").html("");
                            for (var i = 0; i < data.length; i++) {
                                            var currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0);

                                // Date Format
                                var nextDate = new Date(data[i].dtNextDate);
            nextDate.setHours(0, 0, 0, 0);

                                var formattedDate =
                                    ("0" + nextDate.getDate()).slice(-2) + "/" +
                                    ("0" + (nextDate.getMonth() + 1)).slice(-2) + "/" +
                                    nextDate.getFullYear();

                                // Today Check
                                var today = new Date();

                                var isToday =
                                    nextDate.getDate() == today.getDate() &&
                                    nextDate.getMonth() == today.getMonth() &&
                                    nextDate.getFullYear() == today.getFullYear();

                                // Row Color
                                var rowClass = isToday
                                    ? "style='background-color:rgba(25,135,84,0.15);'"
                                    : "";

                                hTable += "<tr " + rowClass + ">";

                                // Serial No
                                hTable += "<td>" + (i + 1) + "</td>";

                                // Court No
                                hTable += "<td>" + data[i].strNexCourtNo + "</td>";

                                // Date
                                hTable += "<td>" + formattedDate + "</td>";

                                // Judge Name
                                hTable += "<td>" + data[i].strNextJudgeName + "</td>";

                                // Remark
                                hTable += "<td>" + data[i].strRemark + "</td>";

                                // Delete Button
                                hTable += "<td>";
                                            if (nextDate >= currentDate) {

                hTable += "<a href='javascript:void(0)' " +
                    "class='btn btn-sm btn-danger' " +
                    "onclick='DeleteCaseDetail(\"" + data[i].intCaseLastStatusID + "\")'>" +
                    "<i class='ph ph-trash'></i> Delete</a>";
            }
            else {

                hTable += "<span class='badge bg-secondary'>Locked</span>";
            }

                                hTable += "</td>";

                                hTable += "</tr>";
                            }

                            $("#tblCaseDetail tbody").html(hTable);

                        }
                        else {

                            $("#tblCaseDetail tbody").html(
                                "<tr>" +
                                "<td colspan='6' style='text-align:center;font-weight:bold;color:#dc3545'>" +
                                "<i>No Record Found!</i>" +
                                "</td>" +
                                "</tr>"
                            );
                        }

                        $('.preloader').hide();
                    },

                    error: function () {

                        $("#tblCaseDetail tbody").html(
                            "<tr>" +
                            "<td colspan='6' style='text-align:center;font-weight:bold;color:#dc3545'>" +
                            "<i>No Record Found!</i>" +
                            "</td>" +
                            "</tr>"
                        );

                        $('.preloader').hide();
                    }
                });
            }
                        function DeleteCaseDetail(id) {
                            console.log(id)
                if (confirm("Are you sure want to delete this record?")) {

                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("DeleteCaseDetails", "ERPMaster")',
                        data: { CaseLastStatusID: id },

                        success: function (result) {
                            if (result.error == "0") {
                                            toastr.success(result.message)
                                fns_BindDataList();
                            }
                            else {
                                  toastr.error(result.message)
                            }
                        },

                        error: function () {

                            alert("Something went wrong!");
                        }
                    });
                }
            }
    </script>