@model AdminJustAndJustice.Models.CaseTypeModel
@using Newtonsoft.Json;
@{
    ViewData["Title"] = "Case Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .duplicate-error {
        background-color: #ffe6e6;
        border: 1px solid red;
    }
</style>
<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Case Type Master</h4>
                    @if (string.IsNullOrEmpty(Model.EditCaseTypeID))
                    {
                        <p class="card-description">
                            Add Case Type
                        </p>
                    }
                    else
                    {
                        <p class="card-description">
                            Update Case Type
                        </p>
                    }
                    <form class="forms-sample" asp-action="AddAndUpdateCaseType" autocomplete="off" asp-controller="ERPMaster" enctype="multipart/form-data">
                        <div class="form-group">
                            <div class="form-group">
                                <label>File upload <span class="text-danger"><b>*</b></span></label>
                                <input type="file" asp-for="fileUpload" class="file-upload-default">
                                    <div class="input-group col-xs-8">
                                        <input type="text" class="form-control file-upload-info" disabled placeholder="Upload Image">
                                        <span class="input-group-append">
                                            <button class="file-upload-browse btn btn-primary" type="button">Upload</button>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-xs-4">
                                    @if (string.IsNullOrEmpty(Model.EditCaseTypeID))
                                    {
                                        <img id="imagePreview" src="" alt="Preview" style="max-width:200px; display:none; border:1px solid #ddd; padding:5px;">
                                    }
                                    else
                                    {
                                        <input type="hidden" asp-for="@Model.EditCaseTypeID" />
                                        <img id="imagePreview" src="@Model.OldImageURL" alt="Preview" style="max-width:200px; border:1px solid #ddd; padding:5px;">
                                    }
                                </div>
                                <label for="CaseType">Case Type <span class="text-danger"><b>*</b></span></label>
                                <input type="text" class="form-control" placeholder="Case Type" maxlength="400" asp-for="CaseType">
                                </div>
                                <div class="form-group">
                                    <label for="ShortCaseType">Short Name <span class="text-danger"><b>*</b></span></label>
                                    <input type="text" class="form-control" placeholder="Short Name" maxlength="300" asp-for="ShortCaseType">
                                    </div>
                                    <div class="form-group">
                                        <label for="MobileNo">Tags<span class="text-danger"><b>*</b></span></label>
                                        @if (string.IsNullOrEmpty(Model.EditCaseTypeID))
                                        {
                                            <div id="phoneContainer">
                                                <div class="input-group mb-2">
                                                    <input type="text" name="Tags" class="form-control phone-input" maxlength="200" placeholder="Tags">
                                                    <button type="button" class="btn btn-danger removePhone">X</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            {
                                                var tagJson = Convert.ToString(Model.Tag);
                                                var tags = string.IsNullOrEmpty(tagJson)
                                                    ? new List<SeoTagsDto>()
                                                    : JsonConvert.DeserializeObject<List<SeoTagsDto>>(tagJson);
                                                @if (tags != null && tags.Count > 0)
                                                {
                                                    @foreach (var m in tags)
                                                    {
                                                        <div id="phoneContainer">
                                                            <div class="input-group mb-2">
                                                                <input type="text" name="Tags" class="form-control phone-input" maxlength="200" placeholder="Tags" value="@m.seotags">
                                                                <button type="button" class="btn btn-danger removePhone">X</button>
                                                            </div>
                                                        </div>
                                            
                                                    }
                                                }
                                            }
                                        }
                                    </div>
                                    <div class="form-group">
                                        <button type="button" class="btn btn-success rounded-5 btn-sm" onclick="addPhone()">+ Add Tags</button>
                                    </div>

                                    <div class="form-group">
                                        <label for="EmailId">Seo Keywords<span class="text-danger"><b>*</b></span></label>
                                        @if (string.IsNullOrEmpty(Model.EditCaseTypeID))
                                        {
                                            <div id="emailContainer" class="mt-3">
                                                <div class="input-group mb-2">
                                                    <input type="text" name="SeoKeywords" class="form-control email-input" placeholder="SeoKeywords">
                                                    <button type="button" class="btn  btn-danger removeEmail">X</button>
                                                </div>
                                            </div>
                                   
                                        }
                                        else
                                        {
                                            {
                                                var seoJson = Convert.ToString(Model.SeoKeyword);
                                                var seo = string.IsNullOrEmpty(seoJson)
                                                    ? new List<SeoKeywordsDto>()
                                                    : JsonConvert.DeserializeObject<List<SeoKeywordsDto>>(seoJson);
                                                @if (seo != null && seo.Count > 0)
                                                {
                                                    <div id="emailContainer" class="mt-3">
                                                        @foreach (var e in seo)
                                                        {
                                                            <div class="input-group mb-2">
                                                                <input type="text" name="SeoKeywords" class="form-control email-input" placeholder="SeoKeywords" value="@e.seoKeywords">
                                                                <button type="button" class="btn  btn-danger removeEmail">X</button>
                                                            </div>
                                                        }
                                                    </div>
                                         
                                                }
                                            }

                                        }
                                        <div class="form-group">
                                            <button type="button" class="btn  rounded-5 btn-success btn-sm" onclick="addEmail()">+ Add Seo keyword</button>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="Detials">Details <span class="text-danger"><b>*</b></span></label>
                                        <textarea class="form-control" asp-for="Detials"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label for="URLText">URL Text<span class="text-danger"><b>*</b></span></label>
                                        <input type="text" class="form-control" maxlength="250" asp-for="URLText" />
                                    </div>
                                    <div class="form-group">
                                        <label for="SeoTitle">SEO Title (maximum 70 characters)<span class="text-danger"><b>*</b></span></label>
                                        <input type="text" class="form-control" maxlength="70" asp-for="SeoTitle" />
                                    </div>
                                    <div class="form-group">
                                        <label for="SeoDescr">SEO Description (maximum 160 characters<span class="text-danger"><b>*</b></span></label>
                                        <input type="text" class="form-control" maxlength="200" asp-for="SeoDescr"/>
                                    </div>
                                   
                                    <div class="form-group">
                                        <label for="SequnceNo">Sequnce No</label>
                                        <input type="text" class="form-control" placeholder="Sequnce No" oninput="return validatePriceInput(this)" onkeypress="restrictInvalidCharacters(event)" maxlength="250" asp-for="SequenceNo">
                                        </div>
                                        @*      <div class="form-group">
                                    <label for="Location">Is Main Address </label>
                                    <textarea class="form-control" asp-for="Location"></textarea>
                                </div> *@
                                        @if (string.IsNullOrEmpty(Model.EditCaseTypeID))
                                        {
                                            <input type="submit" class="btn btn-primary me-2" name="btn_Add" value="Save" />
                                        }
                                        else
                                        {
                                            <input type="hidden" asp-for="@Model.EditCaseTypeID" />
                                            <input type="submit" class="btn btn-primary me-2" name="btn_Add" value="Update" />
                                        }
                                        <a href="/CaseTypeList" class="btn btn-light">Cancel</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <script src="~/lib/jquery/dist/jquery.min.js"></script>
                <script>
                                                    function isDuplicate(value, className) {
                                                    let isExist = false;

                                                    $('.' + className).each(function () {
                                                        if ($(this).val().trim() === value.trim() && value !== "") {
                                                            isExist = true;
                                                        }
                                                    });

                                                    return isExist;
                                                }

                                                function addPhone() {
                                                    let lastValue = $('.phone-input').last().val();

                        
                                                    if (!lastValue) {
                                                            toastr.error("Tags cannot be empty!");
                                                        return;
                                                    }

                
                                                    let isExist = false;
                                                    $('.phone-input').each(function () {
                                                        if ($(this).val().trim() === lastValue) {
                                                            if ($(this).is($('.phone-input').last())) return;
                                                            isExist = true;
                                                        }
                                                    });

                                                    if (isExist) {
                                                            toastr.error("Duplicate Tags not allowed!");
                                                        return;
                                                    }


                                                    $('#phoneContainer').append(`
                                                        <div class="input-group mb-2">
                                                                <input type="text" name="Tags" class="form-control phone-input" maxlength="200"   placeholder="Tags">
                                                            <button type="button" class="btn btn-danger removePhone">X</button>
                                                        </div>
                                                    `);
                                                }

                                     
                                                   $(document).on('blur', '.email-input', function () {

                                        let val = $(this).val().trim().toLowerCase();

                                        // Reset all पहले
                                        $('.email-input').removeClass('duplicate-error');

                                        if (!val) {
                                                toastr.error("Seo Keyword cannot be empty!");
                                            return;
                                        }

                                 

          
                                        let duplicates = [];

                                        $('.email-input').each(function () {
                                            let currentVal = $(this).val().trim().toLowerCase();

                                            if (currentVal && currentVal === val) {
                                                duplicates.push(this);
                                            }
                                        });

                                        if (duplicates.length > 1) {
                                                toastr.error("Duplicate Seo Keyword!");

                
                                            duplicates.forEach(function (el) {
                                                $(el).addClass('duplicate-error');
                                            });
                                        }
                                    });

              
                                                $(document).on('click', '.removePhone', function () {
                                                    $(this).closest('.input-group').remove();
                                                });
                                    $(document).on('input', '.phone-input', function () {
                        $(this).removeClass('duplicate-error');
                    });

                                    $(document).on('input', '.email-input', function () {
                        $(this).removeClass('duplicate-error');
                    });
                                                $(document).on('click', '.removeEmail', function () {
                                                    $(this).closest('.input-group').remove();
                                                });
                                                            function validatePriceInput(element) {
                                                    const input = element.value;
                                                    const validInput = input.replace(/[^0-9]/g, '');
                                                    const parts = validInput.split('.');
                                                    if (parts.length > 2) {
                                                        element.value = parts[0] + '.' + parts[1];
                                                    } else {
                                                        element.value = validInput;
                                                    }
                                                    return true;
                                                }

                                                function restrictInvalidCharacters(event) {
                                                    const charCode = event.which || event.keyCode;
                                                    const charStr = String.fromCharCode(charCode);
                                                    if (!charStr.match(/^[0-9]$/)) {
                                                        event.preventDefault();
                                                        return false;
                                                    }
                                                    return true;
                                                }
                    //                             function isValidEmail(email) {
                    //     let regex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    //     return regex.test(email);
                    // }

                    function addEmail() {

                        let lastValue = $('.email-input').last().val().trim();

                 
                        if (!lastValue) {
                                toastr.error("Seo Keyword cannot be empty!");
                            return;
                        }

                    
                        // if (!isValidEmail(lastValue)) {
                        //         toastr.error("Invalid Seo Keyword format!");
                        //     return;
                        // }

                
                        let isExist = false;
                        $('.email-input').each(function () {
                            if ($(this).val().trim().toLowerCase() === lastValue.toLowerCase()) {
                                if ($(this).is($('.email-input').last())) return;
                                isExist = true;
                            }
                        });

                        if (isExist) {
                                toastr.error("Duplicate Seo Keyword not allowed!");
                            return;
                        }

                        $('#emailContainer').append(`
                            <div class="input-group mb-2">
                                <input type="text" name="SeoKeywords" class="form-control email-input" placeholder="Email">
                                <button type="button" class="btn btn-danger removeEmail">X</button>
                            </div>
                        `);
                    }
                                    $(document).on('blur', '.phone-input', function () {

                        let val = $(this).val().trim();

                        $('.phone-input').removeClass('duplicate-error');

                        if (!val) {
                                toastr.error("Tags cannot be empty!");
                            return;
                        }

                        let duplicates = [];

                        $('.phone-input').each(function () {
                            let currentVal = $(this).val().trim();

                            if (currentVal && currentVal === val) {
                                duplicates.push(this);
                            }
                        });

             
                        if (duplicates.length > 1) {
                                toastr.error("Duplicate Tags!");

                            duplicates.forEach(function (el) {
                                $(el).addClass('duplicate-error');
                            });
                        }
                    });
                       $(document).ready(function () {
                            

                        $('.file-upload-browse').on('click', function () {
                            $('#fileUpload').click();
                        });

                        $('#fileUpload').on('change', function () {

                            let file = this.files[0];
                            let preview = $("#imagePreview");

                            preview.hide();

                            if (!file) return;
                            if (!file.type.startsWith("image/")) {
                                toastr.error("Only image files are allowed!");
                                this.value = "";
                                return;
                            }

                            let reader = new FileReader();

                            reader.onload = function (e) {
                                let img = new Image();

                                img.onload = function () {

                                    if (img.width === 1000 || img.height === 1000) {
                                        toastr.error("Image must be less then 1000 x 1000 pixels!");
                                        $('#fileUpload').val('');
                                        return;
                                    }
                                    toastr.success("Image uploaded successfully!");

                                    preview.attr("src", e.target.result).show();
                                    $('.file-upload-info').val(file.name);
                                };

                                img.src = e.target.result;
                            };

                            reader.readAsDataURL(file);
                        });
                    });
                </script>