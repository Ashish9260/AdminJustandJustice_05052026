          .preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0.3);
    z-index: 9999;

    display: flex;
    justify-content: center;
    align-items: center;
}

.loader {
    width: 80px;
    height: 80px;

    border-radius: 50%;
    border: 4px solid #ddd;
    border-top-color: #29303a;

    animation: loading 1s linear infinite;
}

/* Missing animation */
@@keyframes loading {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}</style>
</head>
